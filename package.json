{
  "name": "gangnam-dental",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run css:build && vite build",
    "css:build": "tailwindcss -c tailwind.config.cjs -i src/styles/tailwind.css -o public/static/tailwind.css && node scripts/tailwind-version.mjs",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "hono": "^4.12.0"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "tailwindcss": "3.4.17",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  },
  "browserslist": [
    "defaults",
    "safari >= 12",
    "ios_saf >= 12"
  ]
}
